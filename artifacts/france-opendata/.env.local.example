# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit real keys.

# URL of your locally running Cloudflare Worker (npm run dev inside cloudflare-worker/)
VITE_WORKER_URL=http://localhost:8787

# GitHub Pages base path — leave empty for local dev (Replit uses BASE_PATH instead)
# VITE_GITHUB_PAGES_BASE=/france-opendata/
